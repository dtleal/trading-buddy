# =============================================================================
# day-trading-buddy environment configuration
# Copy to `.env` (at the project root) and fill in the values below.
# =============================================================================

# -- Required ------------------------------------------------------------------

# Anthropic Claude API key. Used for macro briefings and event explanations.
# Get one at https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=

# -- Optional (graceful degradation if missing) --------------------------------

# FRED (Federal Reserve Economic Data) API key. Free registration at:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# NewsAPI free tier key (100 requests/day). Get one at https://newsapi.org/
NEWSAPI_KEY=

# -- Infrastructure ------------------------------------------------------------

# PostgreSQL connection (used by both backend and docker-compose postgres svc).
POSTGRES_USER=dtb
POSTGRES_PASSWORD=dtb_dev_password
POSTGRES_DB=day_trading_buddy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis connection.
REDIS_HOST=redis
REDIS_PORT=6379

# -- Application tuning --------------------------------------------------------

# Loop cadence in seconds.
TICK_INTERVAL_SECONDS=300

# Output language for user-facing strings (briefings, dashboard labels): "pt" or "en".
OUTPUT_LANGUAGE=pt

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Bias weights (must sum to 1.0).
BIAS_WEIGHT_TECHNICAL=0.40
BIAS_WEIGHT_MACRO=0.30
BIAS_WEIGHT_SENTIMENT=0.30

# Bias thresholds (0-100).
BIAS_THRESHOLD_BULLISH=60
BIAS_THRESHOLD_BEARISH=40

# Anthropic models.
ANTHROPIC_MODEL_BRIEFING=claude-opus-4-7
ANTHROPIC_MODEL_CLASSIFIER=claude-haiku-4-5-20251001
