# =============================================================================
# day-trading-buddy environment configuration
# Copy to `.env` (at the project root) and fill in the values below.
# =============================================================================

# -- Required ------------------------------------------------------------------

# Anthropic Claude API key. Used for macro briefings and event explanations.
# Get one at https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=

# -- Optional (graceful degradation if missing) --------------------------------

# FRED (Federal Reserve Economic Data) API key. Free registration at:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# NewsAPI free tier key (100 requests/day). Get one at https://newsapi.org/
NEWSAPI_KEY=

# -- Infrastructure ------------------------------------------------------------

# PostgreSQL connection (used by both backend and docker-compose postgres svc).
POSTGRES_USER=dtb
POSTGRES_PASSWORD=dtb_dev_password
POSTGRES_DB=day_trading_buddy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis connection.
REDIS_HOST=redis
REDIS_PORT=6379

# Host ports published by docker-compose. Override on shared servers to avoid
# collisions (e.g. on the KVM box that also runs polymarket and kalshi we set
# BACKEND_PORT=8057 / FRONTEND_PORT=3057).
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -- Application tuning --------------------------------------------------------

# Loop cadence in seconds.
TICK_INTERVAL_SECONDS=300

# Output language for user-facing strings (briefings, dashboard labels): "pt" or "en".
OUTPUT_LANGUAGE=pt

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Bias weights (must sum to 1.0).
BIAS_WEIGHT_TECHNICAL=0.40
BIAS_WEIGHT_MACRO=0.30
BIAS_WEIGHT_SENTIMENT=0.30

# Bias thresholds (0-100).
BIAS_THRESHOLD_BULLISH=60
BIAS_THRESHOLD_BEARISH=40

# Anthropic models.
ANTHROPIC_MODEL_BRIEFING=claude-opus-4-7
ANTHROPIC_MODEL_CLASSIFIER=claude-haiku-4-5-20251001

# -- Day-trade signal tuning ---------------------------------------------------
# Account size in USD. Used by `dtb signal` to suggest position size.
# 0 = position sizing is skipped (only the stop levels are shown).
ACCOUNT_SIZE_USD=0
# Risk per trade, as percentage of ACCOUNT_SIZE_USD.
RISK_PER_TRADE_PCT=2.0
# Buffer added to the swing-based stop, in ATR multiples.
STOP_BUFFER_ATR_MULTIPLE=0.5
# Opening-range window in minutes.
OPENING_RANGE_MINUTES=30

# -- Push notifications (ntfy.sh) ---------------------------------------------
# Real push to your phone (iOS/Android) via the ntfy app. The "topic" is a
# secret string — anyone who knows it can subscribe and read your messages,
# so use a long random value (treat it like a password). Empty = disabled.
# Setup:
#   1. Install the ntfy app on your phone (App Store / Play Store, free)
#   2. Pick a topic, e.g. trading-buddy-<your-name>-<random-suffix>
#   3. In the app: + → "Subscribe to topic" → paste the same topic
#   4. Put the same value below
NTFY_TOPIC=
# Override only if self-hosting your own ntfy server. Default is the public
# broker (https://ntfy.sh, free).
NTFY_SERVER=https://ntfy.sh

# -- Breakout detector tuning --------------------------------------------------
# When true, only emit a signal if vol was contracting BEFORE the break
# (ATR(14) <= SMA20(ATR) on the prior bar). When false (default), emit on
# any qualifying Donchian break — the `squeeze` flag is still computed and
# surfaced as a quality badge on the frontend. Set true if you want only
# "coil + explosion" setups; leave false to also catch violent reversals.
BREAKOUT_REQUIRE_SQUEEZE=false
# Minimum range expansion of the breakout bar vs ATR(14). Lower = more
# signals (some marginal), higher = stricter. 1.3 is the classic rule.
BREAKOUT_EXPANSION_ATR_MULTIPLE=1.3
# Donchian channel lookback length on each timeframe.
BREAKOUT_DONCHIAN_N=20

# -- Order flow (live MT5 DOM / footprint / tape) ------------------------------
# Streams depth-of-market, footprint and time&sales from a MetaTrader 5
# terminal (Windows) into the dashboard. Requires the collector under
# `collector/` running next to MT5. See collector/README.md.
# Master switch. When false the ingest socket refuses connections and the
# Fluxo panel stays empty.
ORDERFLOW_ENABLED=false
# Shared secret the collector must present (?token=). Treat like a password —
# long random string, identical to the collector's config.json "token".
ORDERFLOW_INGEST_TOKEN=
# Which symbols carry order flow. Each entry also needs a matching backend→MT5
# mapping in the Windows collector's config.json.
ORDERFLOW_SYMBOLS=USTEC,SPX,GOLD,US30,USOIL,US2000
# Footprint bar width in seconds (60 = 1-minute footprint bars).
ORDERFLOW_FOOTPRINT_INTERVAL_SECONDS=60
# How many footprint bars to retain/broadcast per symbol.
ORDERFLOW_FOOTPRINT_BARS=30
# How many recent trades to keep on the tape per symbol.
ORDERFLOW_TAPE_MAXLEN=200
