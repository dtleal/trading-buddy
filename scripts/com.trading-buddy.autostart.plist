<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  trading-buddy autostart.
  Install via: make autostart-install
  The token __REPO_DIR__ is replaced at install time with the absolute repo path.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trading-buddy.autostart</string>

    <key>RunAtLoad</key>
    <true/>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_DIR__/scripts/autostart-stack.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TRADING_BUDDY_REPO</key>
        <string>__REPO_DIR__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/trading-buddy/launchd.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/trading-buddy/launchd.stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
